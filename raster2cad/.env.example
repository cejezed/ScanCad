# Raster2CAD Environment Variables

# Choose one: Claude (Anthropic) OR OpenAI
# Both APIs are optional - app works with mock analyzer if neither is set

# Claude/Anthropic API Key
# Get it from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk_live_your_claude_key_here

# OpenAI API Key
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_key_here

# Optional: Default DPI for vectorization
DPI=300

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
